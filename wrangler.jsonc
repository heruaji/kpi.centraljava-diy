{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kpi-centraljava-diy-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "DASHBOARD_CACHE",
      "id": "1e2c1951865949b1b4d507ad019397a3"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kpi-centraljava-diy-db",
      "database_id": "fac094e0-e57f-421a-bb43-489db283e32e"
    }
  ],
  "vars": {
    "SHEET_ID": "1knhNraKDgmu7JfiPDZIjEU1sstiQNY0i9mYABaY-oJQ"
  },
  "triggers": {
    "crons": ["0 19 * * *"]
  }
}
